#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                &mo 3               &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E     &kp R      &kp T   &kp PG_UP                                                             &kp K_SCROLL_UP     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp EQUAL   &kp A      &kp S     &kp D     &kp F      &kp G   &kp PG_DN  &kp LEFT_WIN  &mo 2             &kp PAGE_UP    &kp RCTRL   &kp C_AC_SCROLL_UP  &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V      &kp B                            &kp LEFT_ALT      &kp PAGE_DOWN                                  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL   &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &kp ENTER     &kp HOME          &kp END        &kp DELETE  &kp BACKSPACE               &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp ESCAPE  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5  &trans                                      &mo 3   &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp T   &none                                       &none   &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp EQUAL   &kp A         &kp S         &kp D         &kp F         &kp G   &none   &trans  &trans      &trans  &trans  &none   &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT   &kp Z         &kp X         &kp C         &kp V         &kp B                   &trans      &trans                  &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&kp LCTRL   &kp GRAVE     &kp CAPS      &kp LEFT      &kp RIGHT             &trans  &trans  &trans      &trans  &trans  &trans          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3          &kp F4           &kp F5  &tog 1                                                                          &mo 3        &kp F6  &kp F7        &kp F8          &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans          &trans           &trans  &sk UP_ARROW                                                                    &key_repeat  &trans  &trans        &trans          &trans  &trans   &kp F12
&trans  &trans  &trans  &trans          &trans           &trans  &sk DOWN      &trans         &trans              &mmv MOVE_UP     &trans        &caps_word   &trans  &trans        &trans          &trans  &trans   &trans
&trans  &trans  &trans  &trans          &trans           &trans                               &trans              &mmv MOVE_DOWN                              &trans  &trans        &trans          &trans  &trans   &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT          &kp DELETE    &kp BACKSPACE  &mmv MOVE_LEFT      &mmv MOVE_RIGHT  &kp KP_ENTER  &kp SPACE            &msc SCRL_UP  &msc SCRL_DOWN  &trans  &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&rgb_ug RGB_OFF                   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4  &none                                                           &trans           &none  &none       &none       &none  &none  &rgb_ug RGB_COLOR_HSB(110,99,51)
&rgb_ug RGB_ON                    &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &none            &none            &none         &bootloader                                                     &bootloader      &none  &none       &none       &none  &none  &rgb_ug RGB_COLOR_HSB(241,100,52)
&rgb_ug RGB_COLOR_HSB(175,73,50)  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &none            &none            &none         &none        &studio_unlock  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &rgb_ug RGB_COLOR_HSB(300,100,52)
&rgb_ug RGB_COLOR_HSB(51,100,58)  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &macro_ver       &none                                      &none      &none                                    &none  &none       &none       &none  &none  &rgb_ug RGB_COLOR_HSB(204,100,75)
&rgb_ug RGB_COLOR_HSB(0,93,51)    &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF                &none        &none           &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &rgb_ug RGB_COLOR_HSB(67,79,29)
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
